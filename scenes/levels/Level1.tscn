[gd_scene load_steps=20 format=3 uid="uid://level1_scene"]

; =====================================================================
; Level1.tscn — "Hutan Akar Gantung" — Level Pengenalan Mekanik
; =====================================================================
; Layout singkat (tile 16x16, level 80x13 tiles = 1280x208 px):
;
;   ZONA A (col 0..22)  — Tutorial berjalan + FLIP #1
;     - Lantai solid bawah, dinding batu di col 15-16 (row 5..12)
;     - Ceiling solid, gap di col 15-16 row 1 → Player flip ke ceiling
;     - Spike di lantai (col 9) & ceiling (col 11)
;     - Akar platform (col 7-10, row 9)
;
;   ZONA B (col 23..52) — Berjalan di ceiling + FLIP #2
;     - Ceiling solid dengan gap di col 36-38 → Player flip balik ke lantai
;     - Lubang spike trap di lantai (col 30-34) + VoidZone di bawahnya
;     - FlyingEye #1 berpatroli (pos 456, 88)
;     - Akar platform (col 25-30, row 7) & (col 43-48, row 5)
;     - Spike di ceiling (col 45, row 2)
;
;   ZONA C (col 53..79) — Final stretch + FLIP #3 opsional
;     - Dinding kecil (col 63-64, row 8..12) → bisa jump/flip lewat
;     - FlyingEye #2 berpatroli (pos 1096, 168)
;     - Spike di lantai (col 71, row 12)
;     - Checkpoint di col 35 (tengah B-C)
;     - LevelGoal (portal) di col 76-78
; =====================================================================

[ext_resource type="Script" path="res://scripts/Level1.gd" id="1_level1_script"]
[ext_resource type="TileSet" path="res://assets/tilesets/HutanAkarGantung.tres" id="2_tileset"]
[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="3_player"]
