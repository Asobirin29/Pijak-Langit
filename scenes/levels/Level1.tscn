; =====================================================================
; SPIKES — ditempatkan di titik strategis
; Spike 1: lantai Zona A (col 9) — sebelum blokade, zone walk awal
; Spike 2: ceiling Zona A (col 11) — saat player berjalan di ceiling
; Spike 3: tepi lubang Zona B (col 31) — trap saat lubang
; Spike 4: ceiling Zona B (col 45) — saat di platform akar atas
; Spike 5: lantai Zona C (col 71) — area final menuju portal
; =====================================================================
[node name="Spike1" parent="." instance=ExtResource("6_spike")]
; Lantai Zona A — duri mengarah ke atas (default orientation)
