; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes in []
;   param=value ; assign values to parameters

config_version=5

[autoload]

GameState="*res://scripts/GameState.gd"
AudioManager="*res://scripts/AudioManager.gd"

[application]

config/name="Pijak Langit"
config/description="A 2D pixel-art puzzle-platformer"
config/version="0.1.0"
config/tags=PackedStringArray("2d", "platformer", "puzzle", "pixel-art")
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
run/main_scene="res://scenes/Main.tscn"
boot_splash/bg_color=Color(0.0549, 0.0588, 0.0902, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/resizable=true
window/size/borderless=false
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale=3.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

